# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite is default for prototype; switch to PostgreSQL for production
# DATABASE_URL=postgres://user:password@localhost:5432/aerogin_db
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# CORS — React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TODO: SCRAPER-INTEGRATION — Set to True when the real scraper is connected.
# When True, the system will expect live scraper data instead of synthetic data.
LIVE_MODE=False

# --------------------------------------------------------------------------
# Scraper & Anomaly Detection
# --------------------------------------------------------------------------
# How many scrape cycles between automatic retraining of the anomaly detector
RETRAIN_EVERY_N_CYCLES=5

# --------------------------------------------------------------------------
# Real Scraper — MakeMyTrip Playwright + API Providers
# --------------------------------------------------------------------------
# Set REAL_SCRAPER=True (with LIVE_MODE=True) to enable the unified
# RealFareScraper that includes MakeMyTrip Playwright scraping,
# API providers, and fixture fallback.
REAL_SCRAPER=False

# MakeMyTrip scraper delays (seconds) — respectful anti-bot pacing
# Set to 5-10 seconds to avoid triggering rate-based blocking
MMT_SCRAPE_DELAY_MIN=5
MMT_SCRAPE_DELAY_MAX=10

# When True, falls back to bundled fixture data if MMT scraping is blocked
MMT_USE_FIXTURE_FALLBACK=True

# --------------------------------------------------------------------------
# Firebase Authentication & Admin SDK Credentials
# --------------------------------------------------------------------------
# SECURITY WARNING: NEVER commit service account JSON files or raw private keys
# to version control.
#
# How to obtain your own service account key:
# 1. Go to Firebase Console (https://console.firebase.google.com/)
# 2. Select your project -> Project Settings (gear icon) -> "Service accounts" tab
# 3. Click "Generate new private key" -> Confirm "Generate key"
# 4. Save the downloaded JSON file locally outside git tracking.
#
# Option A: Path to your local, gitignored service account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=c:/path/to/your/gitignored/serviceAccountKey.json

# Option B: Entire JSON content in a single line string (recommended for Docker / Cloud CI/CD)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Project ID (found in Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Set to True for development bypass when Firebase keys are not yet configured
FIREBASE_DEV_BYPASS=True

# --------------------------------------------------------------------------
# Flight Info API — Real-time flight status (NOT pricing)
# --------------------------------------------------------------------------
USE_MOCK_FLIGHT_API=True
# TODO: FLIGHT-API-INTEGRATION — Set provider and key when ready
# Supported providers: aviationstack, flightaware, opensky
FLIGHT_API_PROVIDER=
FLIGHT_API_KEY=

# --------------------------------------------------------------------------
# OTP Firewall — Authentication security layer
# --------------------------------------------------------------------------
USE_MOCK_OTP_DELIVERY=True
OTP_REQUIRED_FOR_LOGIN=True
# TODO: OTP-DELIVERY-INTEGRATION — Set provider creds when ready
# OTP_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --------------------------------------------------------------------------
# JWT Authentication
# --------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_EXPIRY_HOURS=24
